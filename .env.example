# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://ekotrace:ekotrace@127.0.0.1:5432/ekotrace
PORT=4000
# Which brand pack to load (folder under brands/). Ekotrace and Carbontek share all code.
BRAND=carbontek
# 127.0.0.1 = only this computer can connect. On a server behind HTTPS: HOST=0.0.0.0
HOST=127.0.0.1

# ---- security (servers) ----
# HTTPS=true
# PUBLIC_URL=https://ekotrace.example.com
# The load balancer / WAF in front, so the real client address is used: true, a hop count, or its addresses
# TRUST_PROXY=1
# 64 hex characters (openssl rand -hex 32); keep in the secret store. Encrypts MFA and SSO secrets.
# DATA_KEY=
# REQUIRE_ADMIN_MFA=true
# RATE_LIMIT_USER=600
# RATE_LIMIT_IP=300
# RATE_LIMIT_LOGIN=20
# AUDIT_RETENTION_MONTHS=24
# SIEM_SYSLOG=tls://siem.example.com:6514
# SIEM_TLS_CA=/etc/ssl/siem-ca.pem
# BACKUP_RETENTION_DAYS=35
# SECURITY_CONTACT=mailto:security@example.com
# E-mail for reminders, escalations and sent-back entries (without it, notices appear in Inbox & to-dos only)
# SMTP_URL=smtps://user:password@mail.example.com:465
# MAIL_FROM=Ekotrace <no-reply@example.com>

# Scanned bills are read by OCR on this server (Tesseract, language data shipped with the app, no outside service).
# OCR=off

# EKOTRACE SME: let companies open their own account at /sme-signup (needs e-mail set up)
# SME_SIGNUP=on

# EKOTRACE SME plan & billing: online payment with Razorpay (UPI, cards, net banking). Off unless all three are set
# AND the seller details below are set; without them the Plan & billing page says "pay by bank transfer — contact us".
# Keys: Razorpay Dashboard → Account & Settings → API keys. Webhook: add https://<your address>/api/public/sme/billing/webhook
# with events payment.captured, order.paid, payment.authorized, payment.failed, and type the same secret here.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# The platform operator (supplier) printed on GST tax invoices. STATE is a state name (e.g. Maharashtra); CGST+SGST
# when the buyer is in the same state, else IGST, at 18%. Confirm the rate and SAC code with your CA.
# SME_SELLER_NAME=Ekobon Private Limited
# SME_SELLER_ADDRESS=Office 1, Example Road, Pune 411001
# SME_SELLER_STATE=Maharashtra
# SME_SELLER_GSTIN=27AAAAA0000A1Z5
# SME_SELLER_PAN=
# SME_SELLER_EMAIL=billing@example.com
# SME_SELLER_SAC=997331
# Invoice numbers: PREFIX/26-27/00001, consecutive per financial year (1-4 letters or digits)
# SME_INVOICE_PREFIX=SME
