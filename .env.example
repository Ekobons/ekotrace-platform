# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://ekotrace:ekotrace@127.0.0.1:5432/ekotrace
PORT=4000
# Which brand pack to load (folder under brands/). Ekotrace and Carbontek share all code.
BRAND=ekotrace
# 127.0.0.1 = only this computer can connect. On a server behind HTTPS: HOST=0.0.0.0
HOST=127.0.0.1
