{
  "name": "@ekotrace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ekotrace API server (Fastify + PostgreSQL).",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@ekotrace/calc": "*",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
