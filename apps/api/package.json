{
  "name": "@ekotrace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ekotrace API server (Fastify + PostgreSQL).",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "serve": "tsx src/server.ts",
    "admin:create": "tsx src/cli/create-admin.ts",
    "admin:list": "tsx src/cli/admins.ts list",
    "admin:reset": "tsx src/cli/admins.ts reset",
    "demo": "tsx src/cli/demo.ts",
    "demo:fin": "tsx src/cli/demoFin.ts",
    "demo:cbam": "tsx src/cli/demoCbamTool.ts",
    "demo:ccts": "tsx src/cli/demoCcts.ts",
    "demo:brsr": "tsx src/cli/demoBrsr.ts",
    "testfiles": "tsx src/cli/makeTestFiles.ts"
  },
  "dependencies": {
    "@ekotrace/calc": "*",
    "@fastify/static": "10.1.6",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "nodemailer": "10.2.1",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "pdf-lib": "1.17.1"
  }
}
