{
  "name": "@ekotrace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ekotrace API server (Fastify + PostgreSQL).",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "serve": "tsx src/server.ts",
    "admin:create": "tsx src/cli/create-admin.ts",
    "demo": "tsx src/cli/demo.ts",
    "testfiles": "tsx src/cli/makeTestFiles.ts"
  },
  "dependencies": {
    "@ekotrace/calc": "*",
    "@fastify/static": "10.1.5",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pdf-lib": "1.17.1"
  }
}
